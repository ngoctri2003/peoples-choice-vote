VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Used only by the /api serverless functions (never exposed to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# MC control page shared secret, appended as ?key=... on /mc and required by /api/*-session
MC_CONTROL_KEY=change-me
